# ---------------------------------------------------------------------------
# HomeBuddy — environment template
# Copy this file to .env before running the project:
#     cp .env.example .env
# Never commit your real .env file.
# ---------------------------------------------------------------------------

# Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-real-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Database
# Option 1: Supabase / PostgreSQL via DATABASE_URL (Recommended for Production & Vercel)
# DATABASE_URL=postgresql://postgres.[project_ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
#
# Option 2: SQLite fallback (USE_SQLITE_FALLBACK=True)
# Option 3: MySQL 8.0 (USE_SQLITE_FALLBACK=False, DB_ENGINE=mysql)
# ---------------------------------------------------------------------------
DATABASE_URL=
DB_ENGINE=sqlite
DB_NAME=homebuddy_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
USE_SQLITE_FALLBACK=True

# ---------------------------------------------------------------------------
# Razorpay
# Leave both keys EMPTY to run in clearly-labelled DEMO mode (no real payments).
# Get test keys at: https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Then set RAZORPAY_DEMO_MODE=False.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_DEMO_MODE=True

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------
PLATFORM_COMMISSION_RATE=10.00
MIN_PAYOUT_AMOUNT=100.00

# ---------------------------------------------------------------------------
# Email (console backend prints emails to the terminal during development)
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@homebuddy.local

# Upload limits (MB)
MAX_UPLOAD_SIZE_MB=5
